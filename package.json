{
  "name": "nirmaancloud-construction-erp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 7000",
    "build": "next build",
    "start": "next start",
    "api:dev": "tsx watch --tsconfig apps/api/tsconfig.json apps/api/src/main.ts",
    "api:build": "tsc -p apps/api/tsconfig.json",
    "api:start": "node dist/api/main.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx --tsconfig apps/api/tsconfig.json prisma/seed.ts",
    "db:setup": "npm run db:generate && npm run db:migrate && npm run db:seed",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "typecheck:api": "tsc -p apps/api/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.19",
    "@nestjs/core": "^11.1.19",
    "@nestjs/platform-express": "^11.1.19",
    "@nestjs/schedule": "^6.1.3",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@types/node": "^20.12.12",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.19",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.14.0",
    "next": "^16.2.6",
    "pg": "^8.20.0",
    "postcss": "^8.4.38",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.0",
    "recharts": "^3.8.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^3.4.3",
    "tsx": "^4.19.2",
    "typescript": "^5.4.5"
  },
  "devDependencies": {
    "prisma": "^7.8.0"
  }
}
