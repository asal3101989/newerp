# --- Database ---
# PostgreSQL connection string. Replace credentials for production.
DATABASE_URL="postgresql://postgres:YOUR_DB_PASSWORD@localhost:5432/nirmaancloud?schema=public"

# --- API Server ---
API_PORT=7001

# --- Security ---
# REQUIRED: Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="replace-with-a-64-char-random-hex-string"

# --- Tenant ---
DEFAULT_TENANT_ID="T-1000"

# --- Frontend (public - safe to expose) ---
# In production, replace 127.0.0.1 with your actual API domain
NEXT_PUBLIC_API_URL="http://127.0.0.1:7001/api/v1"
NEXT_PUBLIC_TENANT_ID="T-1000"

# --- Audit Cleanup ---
# Number of days to retain audit events (default: 90)
AUDIT_RETENTION_DAYS=90
